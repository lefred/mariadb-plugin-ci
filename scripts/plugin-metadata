#!/usr/bin/env python3
"""Write Foundry-style .yml metadata for a built plugin library.

Author, description and license come from the library's own plugin declaration
(_maria_plugin_declarations_ or _mysql_plugin_declarations_), so they match what
the server reports whether the plugin defines them as literals or CMake macros.
"""
import json
import re
import struct
import sys

LICENSES = {0: 'Proprietary', 1: 'GPLv2', 2: 'BSD'}
SHT_SYMTAB, SHT_RELA, SHT_DYNSYM, PT_LOAD = 2, 4, 11, 1


def fail(message):
    raise RuntimeError(message)


class Elf:
    def __init__(self, path):
        with open(path, 'rb') as stream:
            self.data = data = stream.read()
        if data[:4] != b'\x7fELF' or data[4] != 2 or data[5] != 1:
            fail('Not a 64-bit little-endian ELF library: ' + path)
        phoff, shoff = struct.unpack_from('<QQ', data, 32)
        phentsize, phnum, shentsize, shnum = struct.unpack_from('<HHHH', data, 54)
        self.loads = []
        for i in range(phnum):
            p_type, _, offset, vaddr, _, filesz = struct.unpack_from('<IIQQQQ', data, phoff + i * phentsize)
            if p_type == PT_LOAD:
                self.loads.append((vaddr, filesz, offset))
        sections = [struct.unpack_from('<IIQQQQIIQQ', data, shoff + i * shentsize) for i in range(shnum)]
        self.symbols, self.relocations = {}, {}
        for _, kind, _, _, offset, size, link, _, _, entsize in sections:
            if kind in (SHT_SYMTAB, SHT_DYNSYM):
                names = sections[link][4]
                table = []
                for at in range(offset, offset + size, entsize):
                    name, _, _, _, value, length = struct.unpack_from('<IBBHQQ', data, at)
                    label = data[names + name:data.index(b'\0', names + name)].decode()
                    table.append((value, length))
                    if label and value:
                        self.symbols.setdefault(label, (value, length))
                if kind == SHT_DYNSYM:
                    self.dynsym = table
        for _, kind, _, _, offset, size, link, _, _, entsize in sections:
            if kind == SHT_RELA:
                for at in range(offset, offset + size, entsize):
                    where, info, addend = struct.unpack_from('<QQq', data, at)
                    symbol = info >> 32
                    base = self.dynsym[symbol][0] if symbol and sections[link][1] == SHT_DYNSYM else 0
                    self.relocations[where] = base + addend

    def offset(self, address):
        for vaddr, filesz, offset in self.loads:
            if vaddr <= address < vaddr + filesz:
                return offset + address - vaddr
        fail('Address outside the file: {:#x}'.format(address))

    def word(self, address, fmt='<Q'):
        return struct.unpack_from(fmt, self.data, self.offset(address))[0]

    def pointer(self, address):
        # RELA stores the target in the relocation; RELR and static links keep it in place.
        return self.relocations.get(address, self.word(address))

    def string(self, address):
        target = self.pointer(address)
        if not target:
            return ''
        start = self.offset(target)
        return self.data[start:self.data.index(b'\0', start)].decode('utf-8', 'replace')


def declarations(elf):
    for prefix in ('maria', 'mysql'):
        if '_{}_plugin_declarations_'.format(prefix) in elf.symbols:
            address, length = elf.symbols['_{}_plugin_declarations_'.format(prefix)]
            sizeof = elf.symbols.get('_{}_sizeof_struct_st_plugin_'.format(prefix))
            stride = elf.word(sizeof[0], '<i') if sizeof else length
            # st_maria_plugin / st_mysql_plugin share the leading fields:
            # int type; void *info; const char *name, *author, *descr; int license;
            for entry in range(address, address + max(length, stride), stride):
                if not elf.word(entry, '<i'):
                    break
                yield {'name': elf.string(entry + 16), 'author': elf.string(entry + 24),
                       'description': elf.string(entry + 32),
                       'license': LICENSES.get(elf.word(entry + 40, '<i'), 'Unknown')}
            return
    fail('No plugin declaration found')


def scalar(value):
    if re.fullmatch(r'[A-Za-z0-9_./(][A-Za-z0-9 _.,;()/+@<>=-]*', value) and not value.endswith(' '):
        return value
    return json.dumps(value)


def main():
    if len(sys.argv) != 8:
        fail('Usage: plugin-metadata LIBRARY NAME FILENAME VERSION SERVER PLATFORM REVISION')
    library, plugin, filename, version, server, platform, revision = sys.argv[1:]
    found = list(declarations(Elf(library)))
    if not found:
        fail('Empty plugin declaration in ' + library)
    declaration = next((d for d in found if d['name'].lower() == plugin.lower()), found[0])
    fields = [('name', plugin), ('filename', filename), ('version', version), ('server', server),
              ('platform', platform), ('author', declaration['author']),
              ('description', declaration['description']), ('license', declaration['license'])]
    if revision:
        fields.append(('version_source_revision', revision))
    lines = ['{}{}: {}'.format('- ' if i == 0 else '  ', key, scalar(value))
             for i, (key, value) in enumerate(fields)]
    sys.stdout.write('\n'.join(lines) + '\n')


if __name__ == '__main__':
    try:
        main()
    except (RuntimeError, OSError, struct.error, ValueError, IndexError) as error:
        sys.exit('plugin-metadata: ' + str(error))
